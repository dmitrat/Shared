<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2012/06/nuspec.xsd">
  <metadata>
    <id>OutWit.Shared.Messenger.Provider.Telegram</id>
    <version>$version$</version>
    <authors>Dmitry Ratner</authors>
    <description>Telegram messenger transport plugin for OutWit hosts. HTTP Bot API based — sends notifications to any chat / channel. Drop into the host's @Messenger folder and set Messenger__ProviderKey=Telegram (token via Telegram__BotToken).</description>
    <copyright>Copyright © 2026 Dmitry Ratner</copyright>
    <license type="expression">Apache-2.0</license>
    <projectUrl>https://github.com/dmitrat/Shared/tree/main/Messenger/OutWit.Shared.Messenger.Provider.Telegram</projectUrl>
    <tags>OutWit Shared Messenger Provider Telegram</tags>
    <readme>README.md</readme>
    <icon>OutWit-logo.png</icon>
  </metadata>
  <files>
    <file src="README.md" target="\" />
    <file src="OutWit-logo.png" target="\" />
    <file src="NOTICE.txt" target="\" />
    <file src="LICENSE.txt" target="\" />
    <file src="build\OutWit.Shared.Messenger.Provider.Telegram.targets" target="build" />
    <file src="build\OutWit.Shared.Messenger.Provider.Telegram.targets" target="buildTransitive" />
    <file src="..\..\@Messenger\Release\telegram.module\**\*" target="messenger\telegram.module" />
    <file src="bin\Release\net10.0\OutWit.Shared.Messenger.Provider.Telegram.dll" target="lib\net10.0" />
  </files>
</package>
