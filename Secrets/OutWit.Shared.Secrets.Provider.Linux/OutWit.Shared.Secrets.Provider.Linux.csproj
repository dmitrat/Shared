<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net10.0;net9.0;net8.0</TargetFrameworks>
		<Nullable>enable</Nullable>

		<!-- LibraryImport-generated marshalling emits unsafe code. -->
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>

		<Version>1.0.0</Version>

		<Description>Linux Secret Service (libsecret) provider for OutWit.Shared.Secrets, for interactive desktop sessions with an unlocked keyring. The Secret Service is a session service: a systemd unit with no session, or a container, has no session bus — the honest answer there is SecretStatus.Unavailable, and the File provider is the deliberate choice. Payloads are stored base64-encoded (the libsecret password API is string-based); find entries with secret-tool lookup key {key}.</Description>
		<PackageTags>OutWit;Shared;Secrets;Provider;Linux;libsecret;SecretService;Keyring</PackageTags>

		<RepositoryUrl>https://github.com/dmitrat/Shared/tree/main/Secrets/OutWit.Shared.Secrets.Provider.Linux</RepositoryUrl>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\OutWit.Shared.Secrets.Providers\OutWit.Shared.Secrets.Providers.csproj" />
	</ItemGroup>

	<!-- Metadata files for the NuGet package (SDK Pack). -->
	<ItemGroup>
		<None Include="LICENSE.txt" Pack="true" PackagePath="\" />
		<None Include="NOTICE.txt" Pack="true" PackagePath="\" />
		<None Include="README.md" Pack="true" PackagePath="\" />
		<None Include="OutWit-logo.png" Pack="true" PackagePath="\" />
	</ItemGroup>

</Project>
