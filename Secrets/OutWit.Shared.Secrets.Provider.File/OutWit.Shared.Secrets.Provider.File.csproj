<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net10.0;net9.0;net8.0</TargetFrameworks>
		<Nullable>enable</Nullable>

		<!-- LibraryImport-generated marshalling (libc fsync) emits unsafe code. -->
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>

		<Version>1.0.0</Version>

		<Description>File-based fallback provider for OutWit.Shared.Secrets — for deployments with no reachable OS credential store (containers, session-less services). Never selected automatically: configuration names it. One file per key with owner-only permissions verified at creation, atomic replace via temp-file-and-rename, DPAPI machine-scope protection on Windows (Protection=FileWithPlatformKey) and honest FileOnly elsewhere. Read the package README for what this does not defend against.</Description>
		<PackageTags>OutWit;Shared;Secrets;Provider;File;Fallback;DPAPI</PackageTags>

		<RepositoryUrl>https://github.com/dmitrat/Shared/tree/main/Secrets/OutWit.Shared.Secrets.Provider.File</RepositoryUrl>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.11" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\OutWit.Shared.Secrets.Providers\OutWit.Shared.Secrets.Providers.csproj" />
	</ItemGroup>

	<!-- Metadata files for the NuGet package (SDK Pack). -->
	<ItemGroup>
		<None Include="LICENSE.txt" Pack="true" PackagePath="\" />
		<None Include="NOTICE.txt" Pack="true" PackagePath="\" />
		<None Include="README.md" Pack="true" PackagePath="\" />
		<None Include="OutWit-logo.png" Pack="true" PackagePath="\" />
	</ItemGroup>

</Project>
