<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net10.0;net9.0;net8.0</TargetFrameworks>
		<Nullable>enable</Nullable>

		<!-- LibraryImport-generated marshalling emits unsafe code. -->
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>

		<Version>1.0.0</Version>

		<Description>macOS Keychain provider for OutWit.Shared.Secrets: generic passwords in the login keychain via the Security framework, replaced in place (no delete-then-add window). For user-facing applications; a daemon belongs in the System keychain, which this provider does not manage. An item added by one binary and read by another prompts — and a prompt in a service is a hang.</Description>
		<PackageTags>OutWit;Shared;Secrets;Provider;MacOS;Keychain;Security</PackageTags>

		<RepositoryUrl>https://github.com/dmitrat/Shared/tree/main/Secrets/OutWit.Shared.Secrets.Provider.MacOS</RepositoryUrl>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\OutWit.Shared.Secrets.Providers\OutWit.Shared.Secrets.Providers.csproj" />
	</ItemGroup>

	<!-- Metadata files for the NuGet package (SDK Pack). -->
	<ItemGroup>
		<None Include="LICENSE.txt" Pack="true" PackagePath="\" />
		<None Include="NOTICE.txt" Pack="true" PackagePath="\" />
		<None Include="README.md" Pack="true" PackagePath="\" />
		<None Include="OutWit-logo.png" Pack="true" PackagePath="\" />
	</ItemGroup>

</Project>
