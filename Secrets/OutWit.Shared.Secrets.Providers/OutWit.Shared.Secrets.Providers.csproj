<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net10.0;net9.0;net8.0;net7.0;net6.0</TargetFrameworks>
		<Nullable>enable</Nullable>

		<Version>1.0.0</Version>

		<Description>Abstractions for OutWit secret storage: ISecretStore over the operating system's credential store (Windows Credential Manager, macOS Keychain, libsecret), with an explicit status model that never confuses "no secret" with "the store will not open". Providers ship as separate OutWit.Shared.Secrets.Provider.* packages; hosts register one at the composition root. For long-lived credentials — tokens, keys, passphrases — not certificates or blobs.</Description>
		<PackageTags>OutWit;Shared;Secrets;Credentials;SecretStore;Security</PackageTags>

		<RepositoryUrl>https://github.com/dmitrat/Shared/tree/main/Secrets/OutWit.Shared.Secrets.Providers</RepositoryUrl>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="OutWit.Common" Version="1.4.0" />
	</ItemGroup>

	<!-- Metadata files for the NuGet package (SDK Pack). LICENSE/NOTICE use .txt
		 extensions: extensionless files break NuGet's zip writer when packed with
		 target="\" alongside <license type=...>. -->
	<ItemGroup>
		<None Include="LICENSE.txt" Pack="true" PackagePath="\" />
		<None Include="NOTICE.txt" Pack="true" PackagePath="\" />
		<None Include="README.md" Pack="true" PackagePath="\" />
		<None Include="OutWit-logo.png" Pack="true" PackagePath="\" />
	</ItemGroup>

</Project>
