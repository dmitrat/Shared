<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net10.0;net9.0;net8.0</TargetFrameworks>
		<Nullable>enable</Nullable>

		<Version>1.0.0</Version>

		<Description>Conformance suite for OutWit.Shared.Secrets providers: NUnit fixtures a provider's test project inherits and points at its own store. The abstraction's promises — status model, atomic replace, size and key limits, case injectivity — are tested against every implementation by that implementation's own author, rather than restated in each one's tests. A provider whose Description.CanWrite is false runs the read-side tests only.</Description>
		<PackageTags>OutWit;Shared;Secrets;Conformance;Testing;NUnit</PackageTags>

		<RepositoryUrl>https://github.com/dmitrat/Shared/tree/main/Secrets/OutWit.Shared.Secrets.Conformance</RepositoryUrl>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="NUnit" Version="4.6.1" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\OutWit.Shared.Secrets.Providers\OutWit.Shared.Secrets.Providers.csproj" />
	</ItemGroup>

	<!-- Metadata files for the NuGet package (SDK Pack). -->
	<ItemGroup>
		<None Include="LICENSE.txt" Pack="true" PackagePath="\" />
		<None Include="NOTICE.txt" Pack="true" PackagePath="\" />
		<None Include="README.md" Pack="true" PackagePath="\" />
		<None Include="OutWit-logo.png" Pack="true" PackagePath="\" />
	</ItemGroup>

</Project>
