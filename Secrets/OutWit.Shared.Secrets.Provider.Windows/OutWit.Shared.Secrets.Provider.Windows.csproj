<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net10.0;net9.0;net8.0</TargetFrameworks>
		<Nullable>enable</Nullable>

		<!-- LibraryImport-generated marshalling emits unsafe code. -->
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>

		<Version>1.0.0</Version>

		<Description>Windows Credential Manager provider for OutWit.Shared.Secrets. Generic credentials via advapi32 (LibraryImport, NativeAOT-clean), in the vault of the account the process runs as: an interactive user cannot read a service's credential, and vice versa. Register at the composition root; entries appear in Credential Manager → Windows Credentials → Generic Credentials under "{key}#{hash}".</Description>
		<PackageTags>OutWit;Shared;Secrets;Provider;Windows;CredentialManager;DPAPI</PackageTags>

		<RepositoryUrl>https://github.com/dmitrat/Shared/tree/main/Secrets/OutWit.Shared.Secrets.Provider.Windows</RepositoryUrl>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\OutWit.Shared.Secrets.Providers\OutWit.Shared.Secrets.Providers.csproj" />
	</ItemGroup>

	<!-- Metadata files for the NuGet package (SDK Pack). -->
	<ItemGroup>
		<None Include="LICENSE.txt" Pack="true" PackagePath="\" />
		<None Include="NOTICE.txt" Pack="true" PackagePath="\" />
		<None Include="README.md" Pack="true" PackagePath="\" />
		<None Include="OutWit-logo.png" Pack="true" PackagePath="\" />
	</ItemGroup>

</Project>
